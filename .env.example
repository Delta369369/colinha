PORT=8080
SERPAPI_API_KEY=
# HTTPS público do backend, acessível à SerpApi (sem barra final).
PUBLIC_BASE_URL=https://seu-backend.example.com
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEARCH_ACCESS_TOKEN=
ALLOWED_ORIGINS=https://delta369369.github.io,http://localhost:8080
# Ative somente se seu plano SerpApi oferecer ZeroTrace (Enterprise).
SERPAPI_ZERO_TRACE=false
MAX_RESULTS=40
LANGUAGE_CHECK_LIMIT=40
